APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=5000
SECRET_KEY=change-this-secret

DATABASE_URL=sqlite:///instance/community_radio.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
RADIO_API_KEY=change-this-api-key

SMS_ENABLED=true
SMS_PORT=/dev/ttyUSB2
SMS_BAUD=115200

SMS_AUTO_DELETE=true
SMS_POLL_INTERVAL=3

CALL_ENABLED=true
CALL_AUTO_REJECT=true

AUTO_ANNOUNCE=true

PIPER_EXECUTABLE=piper
PIPER_MODEL=models_voice/th_TH-model.onnx

AUDIO_PLAYER=aplay
AUDIO_DEVICE=default
AUDIO_OUTPUT_DIR=static/audio

MAX_MESSAGE_LENGTH=500
RATE_LIMIT_PER_HOUR=10

MULTIPART_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO
